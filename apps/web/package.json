{
  "name": "@glassflow/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "node scripts/fixture.mjs dev",
    "build": "tsc -b && vite build",
    "build:fixture": "tsc -b && node scripts/fixture.mjs build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "e2e:fixture": "playwright test --config playwright.fixture.config.ts",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "e2e:integration": "playwright test --config playwright.integrated.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.81.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
